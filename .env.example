# Sentinel environment variables — TEMPLATE ONLY.
# Copy values into your own environment (or an untracked, mode-0600 file).
# The database stores only the NAMES of secret variables, never their values.
# Never commit a file containing real secrets.

# Path to the static settings file (optional; defaults to config/settings.toml).
# SENTINEL_CONFIG=/home/sentinel/sentinel/config/settings.toml

# Override the SQLite database path from settings.toml.
# SENTINEL_DB_PATH=/home/sentinel/sentinel/sentinel.db

# Session signing key. The API refuses to start without it. Generate a random
# 256-bit value and keep it outside the repository.
# SENTINEL_SESSION_KEY=

# Notification secrets: the channel config stores these NAMES, not values.
# SENTINEL_WEBHOOK_SECRET=
# SENTINEL_SMTP_PASSWORD=
# SENTINEL_TELEGRAM_TOKEN=
