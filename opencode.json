{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory":"deny" ,
    "read":"allow" ,
    "edit": "allow",
    "skill": {
      "*": "ask",
      "sentinel-*": "allow"
    },
    "bash": {
      "*": "ask",
      "ls*": "allow",
      "cat*": "allow",
      "grep*": "allow",
      "mkdir*": "allow",
      "make*": "allow",
      "pytest*": "allow",
      "python -m pytest*": "allow",
      "python cli.py*": "allow",
      "ruff*": "allow",
      "mypy*": "allow",
      "npm run*": "allow",
      "npm test*": "allow",
      "npm ci": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "pip install -e*": "allow",
      "pip install*": "ask",
      "npm install*": "ask",
      "npx playwright install*": "ask",
      "uvicorn*": "ask",
      "sudo*": "deny",
      "rm -rf*": "deny",
      "git push*": "deny",
      "curl*": "deny",
      "wget*": "deny",
      "chmod*": "ask",
      "chown*": "deny"
    }
  }
}
